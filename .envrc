#!/usr/bin/env bash

source_up_if_exists

# The dev shell contains jaccard-stored and jaccard-store built by gonixgo,
# so reload it (and rebuild them) whenever the Go sources change. watch_dir
# covers files added later too; Nix only sees files that git tracks, so
# `git add` new ones.
watch_file go.mod go.sum
watch_dir admin
watch_dir bucket
watch_dir client
watch_dir cmd
watch_dir db
watch_dir keyset
watch_dir node
watch_dir packfile
watch_dir server
watch_dir sketch
watch_dir verify
watch_dir wire

# Evaluating a gonixgo package runs `gonixgo resolve` through builtins.exec.
use flake . --option allow-unsafe-native-code-during-evaluation true
